# Copy to .env for local development.
NODE_ENV=development
PORT=3000

# Local Postgres (e.g. `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16-alpine`)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/edugo_payments

SERVICE_NAME=edugo-payments-service

# HMAC secret for verifying inbound operator webhooks (ADR-0006 — Secret Manager in
# production, ASM-1). A dev default is baked into the config loader; set this in
# staging/production. Never commit a real secret.
# OPERATOR_WEBHOOK_SECRET=change-me

# Observability is opt-in: telemetry only starts when an OTLP endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
